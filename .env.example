# LiveKit keys (the same ones configured in livekit.yaml / docker-compose.livekit.yml)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Legacy mode: public LiveKit WebSocket URL. Host-control mode: private upstream URL,
# e.g. ws://host.docker.internal:7880, accessible only from the application server.
LIVEKIT_URL=wss://lk.yourdomain.com
# Opt-in after applying migrations AND fencing every public LiveKit signaling route.
# Browsers use APP_URL/api/sala/conexao in this mode. See docs/host-controls.md.
ROOM_HOST_CONTROLS_ENABLED=false

# Optional: if set (8+ characters), this password is required to join any room.
# Each IP gets 5 wrong attempts every 15 minutes. Leave it empty for a public instance.
ACCESS_PASSWORD=

# Optional: participant limit per room (2 to 8). Default: 6.
MAX_PARTICIPANTS=6
# Participant e-mail confirmation (default false). "true" sends a link at sign-up and
# blocks sign-in and rooms until the participant confirms the e-mail.
REQUIRE_EMAIL_VERIFICATION=false

# Optional: how many trusted proxies sit in front of the app (default 1 = Coolify's
# Traefik). Use 2 if the app domain also goes through the Cloudflare proxy.
TRUSTED_PROXY_HOPS=1

# Required: Postgres (accounts, rooms, settings). Use the nelcota_app role (no DDL).
# Migrations are a separate job (pnpm db:migrate / deploy), never at boot.
DATABASE_URL=postgres://nelcota_app:<password>@host:5432/nelcota

# Required: secret for participant accounts (Better Auth). openssl rand -base64 48
AUTH_SECRET=

# /admin panel (Better Auth). Without ADMIN_AUTH_SECRET the panel is disabled.
# Generate with: openssl rand -base64 48
ADMIN_AUTH_SECRET=
# Public origin of the app (invitation and password reset links).
APP_URL=http://127.0.0.1:3111
# Optional transactional e-mail. Choose Resend API or SMTP, then set the sender.
# Without a provider, production fails each delivery (logged); dev logs the content.
# A provider is required with REQUIRE_EMAIL_VERIFICATION=true or MAIL_FROM set.
# Resend: use a sending-only key scoped to your verified domain.
RESEND_API_KEY=
# Alternative provider: leave empty when using Resend.
SMTP_URL=
# Sender when none is saved in the panel (E-mails), which wins over this one.
# Example: MAIL_FROM=Nelcota <no-reply@yourdomain.com>
# The domain must be verified at Resend; failures log it as senderDomain.
MAIL_FROM=

# Only for local `pnpm db:migrate`. In production it lives in the CI secrets, NEVER in the app.
MIGRATOR_DATABASE_URL=

# DISPOSABLE database for integration tests (Vitest recreates databases from it).
TEST_DATABASE_URL=

# Optional: password of the participants `pnpm db:seed` creates (random when empty).
SEED_PASSWORD=

# Observability (optional)
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
# Sentry issues page; the admin panel links recent errors to it.
SENTRY_ISSUES_URL=
LOG_LEVEL=

# GIFs in messages (optional, klipy.com). Public: the browser calls KLIPY with it.
# Empty hides the GIF button.
KLIPY_API_KEY=
